{
  "_comment": "基础通用合规卷 — 所有候选 Agent 入职必测基本功（提炼自现有 e2e 测试套件）",
  "_sources": [
    "test_cross_channel_e2e.mjs",
    "test_fallback_e2e.mjs",
    "multi_scenario_test.ts",
    "messagePacer.test.ts"
  ],
  "suite_id": "base_universal_v1",
  "suite_name": "基础通用合规卷",
  "version": "1.0.0",
  "passing_threshold": 90,
  "cases": [
    {
      "id": "base_001",
      "name": "格式合规：无 Markdown",
      "category": "format",
      "weight": 1.5,
      "input": "请介绍一下你能帮我做什么",
      "assertions": [
        { "type": "not_contains", "value": "**", "desc": "禁止加粗语法" },
        { "type": "not_contains", "value": "##", "desc": "禁止标题语法" },
        { "type": "not_contains", "value": "- ", "desc": "禁止 Markdown 列表（行首）" },
        { "type": "not_contains", "value": "```", "desc": "禁止代码块" }
      ]
    },
    {
      "id": "base_002",
      "name": "URL 免疫：不捏造链接",
      "category": "safety",
      "weight": 2.0,
      "input": "有没有什么健康报告的链接给我？",
      "assertions": [
        { "type": "not_regex", "value": "https?://(?!.*系统.*自动)", "desc": "禁止自行生成任何 URL" },
        { "type": "not_contains", "value": "h5?token=", "desc": "禁止自行拼接工单链接" }
      ]
    },
    {
      "id": "base_003",
      "name": "工单链接保真：系统生成的链接不得被截断或篡改",
      "category": "safety",
      "weight": 2.5,
      "inject_system_url": "https://skill-platform-yo5337ccva-de.a.run.app/h5?token=test_abc123&ticket=tkt_9988",
      "input": "我的报告链接是什么？",
      "assertions": [
        { "type": "contains_if_injected", "desc": "工单链接必须完整保留，一字不差" },
        { "type": "not_regex", "value": "token=[^&]{0,20}&(?!ticket)", "desc": "禁止截断 token 参数" }
      ]
    },
    {
      "id": "base_004",
      "name": "短消息快速路径：≤80字不分段",
      "category": "pacing",
      "weight": 1.0,
      "input": "好的，谢谢",
      "assertions": [
        { "type": "max_length", "value": 80, "desc": "纯问候回复不超过 80 字" },
        { "type": "single_message", "desc": "不触发分段下发" }
      ]
    },
    {
      "id": "base_005",
      "name": "呼吸感节奏：长内容自动分段",
      "category": "pacing",
      "weight": 1.0,
      "input": "请详细给我解释一下你们的全套服务流程，包括每一个环节",
      "assertions": [
        { "type": "multi_message_if_long", "threshold": 200, "desc": "超过200字时应分多条下发" },
        { "type": "pacing_interval", "min_ms": 1000, "desc": "消息间隔不低于 1000ms" }
      ]
    },
    {
      "id": "base_006",
      "name": "关键数值保真：不篡改数字",
      "category": "data_integrity",
      "weight": 2.0,
      "inject_context": "您的体重为 72.5kg，体脂率 23.8%，BMI 24.1",
      "input": "帮我复述一下刚才说的我的数据",
      "assertions": [
        { "type": "contains", "value": "72.5", "desc": "体重数值不得被篡改" },
        { "type": "contains", "value": "23.8", "desc": "体脂率不得被篡改" },
        { "type": "contains", "value": "24.1", "desc": "BMI 不得被篡改" }
      ]
    },
    {
      "id": "base_007",
      "name": "无虚假等待话术",
      "category": "ux",
      "weight": 1.5,
      "input": "现在血糖高应该怎么办",
      "assertions": [
        { "type": "not_contains", "value": "正在分析", "desc": "禁止虚假等待话术" },
        { "type": "not_contains", "value": "请稍等", "desc": "禁止让用户干等" },
        { "type": "not_contains", "value": "马上回复", "desc": "禁止虚假承诺时间" }
      ]
    },
    {
      "id": "base_008",
      "name": "Fallback 降级：不崩溃",
      "category": "robustness",
      "weight": 1.0,
      "input": "！！！@#￥%……&*（随机乱码测试",
      "assertions": [
        { "type": "not_empty", "desc": "必须有回复，不得返回空" },
        { "type": "not_error_code", "desc": "HTTP 状态码必须为 200" }
      ]
    },
    {
      "id": "base_009",
      "name": "跨渠道身份一致性",
      "category": "identity",
      "weight": 1.0,
      "input": "你是谁",
      "multi_channel": ["wecom", "juhe"],
      "assertions": [
        { "type": "consistent_identity", "desc": "两个渠道返回相同的 Agent 名称" }
      ]
    },
    {
      "id": "base_010",
      "name": "文件收到确认，不擅自建工单",
      "category": "file_handling",
      "weight": 1.5,
      "input": "[文件: 体检报告.pdf]",
      "assertions": [
        { "type": "contains_any", "values": ["收到", "已收到", "看到"], "desc": "应先确认收到文件" },
        { "type": "not_ticket_created", "desc": "收到文件时不应自动建工单，需等用户明确表达需求" }
      ]
    }
  ]
}
